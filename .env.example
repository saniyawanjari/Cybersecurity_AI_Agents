# Database Connection URL: defaults to SQLite fallback, switch to PostgreSQL when running Docker
DATABASE_URL=sqlite:///./audit.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/soc_guard

# Open Policy Agent (OPA) server endpoint
OPA_URL=http://localhost:8181/v1/data/authz/allow

# Admin secret key for audit inspection and token revocation endpoints
ADMIN_KEY=supersecretadminkey123
